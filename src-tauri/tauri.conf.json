{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clayform",
  "version": "0.11.0",
  "identifier": "com.clayform.app",
  "build": {
    "beforeDevCommand": { "script": "trunk serve --port 1420", "cwd": "../app", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../app" },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clayform",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#1a1b1f"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Digital sculpting",
    "longDescription": "Clayform, a SculptGL-style digital sculpting app.",
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
